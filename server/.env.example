# VerifyIT API configuration. Copy to server/.env and fill in real values.
# Never commit server/.env. Never put a service-role/secret key here: the API only needs the anon key.

PORT=4000
NODE_ENV=development

# Origins allowed to call the API (comma-separated). The Vite dev server runs on 5173.
FRONTEND_URL=http://localhost:5173

# Public URL of the website. Printed on certificates and encoded in their QR codes.
# In production this must be the real https URL (localhost is rejected).
PUBLIC_APP_URL=http://localhost:5173

# Supabase: Project Settings > API. Use the anon / publishable key, not the service_role / secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional settings
# Time zone used to print the issue date on certificates.
CERTIFICATE_TIMEZONE=Asia/Manila
# Number of reverse proxies in front of the API (set to 1 on most hosting platforms) so rate limits see real client IPs.
TRUST_PROXY=0
# debug | info | warn | error | silent
LOG_LEVEL=info

# AI Investigation Assistant (optional). OpenRouter is tried first; Groq is tried once if it fails.
# Leave both keys unset to turn the assistant off (POST /api/v1/ai/analyze then answers 503 AI_NOT_CONFIGURED).
# Keys are server-side secrets: never put them in the frontend .env. On Cloudflare, add them with
# `npx wrangler secret put OPENROUTER_API_KEY` (and GROQ_API_KEY) instead of a plain variable.
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b
# Models used when the student attaches images. OpenRouter's defaults to OPENROUTER_MODEL (Gemma reads images);
# gpt-oss reads text only, so Groq switches to an image-reading model.
# OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# "What Other Sources Say": a Google Cloud API key restricted to the Fact Check Tools API (free). Unset turns the
# check off (POST /api/v1/ai/check-sources then answers 503 FACT_CHECK_NOT_CONFIGURED).
# GOOGLE_FACT_CHECK_API_KEY=your-google-api-key
# Same check: a Tavily API key (free tier at tavily.com) that also looks for other news reports of the same story.
# Unset, only fact-checks are searched; with neither key the check is off.
# TAVILY_API_KEY=your-tavily-api-key
# Timeout per provider attempt in milliseconds (1000-30000).
# AI_TIMEOUT_MS=25000
