# VerifyIT API configuration. Copy to server/.env and fill in real values.
# Never commit server/.env. Never put a service-role/secret key here: the API only needs the anon key.

PORT=4000
NODE_ENV=development

# Origins allowed to call the API (comma-separated). The Vite dev server runs on 5173.
FRONTEND_URL=http://localhost:5173

# Public URL of the website. Printed on certificates and encoded in their QR codes.
# In production this must be the real https URL (localhost is rejected).
PUBLIC_APP_URL=http://localhost:5173

# Supabase: Project Settings > API. Use the anon / publishable key, not the service_role / secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional settings
# Time zone used to print the issue date on certificates.
CERTIFICATE_TIMEZONE=Asia/Manila
# Number of reverse proxies in front of the API (set to 1 on most hosting platforms) so rate limits see real client IPs.
TRUST_PROXY=0
# debug | info | warn | error | silent
LOG_LEVEL=info
