# VerifyIT frontend configuration. Copy to .env.local (ignored by Git) and fill in the values.
# Everything starting with VITE_ is bundled into the public website. Only put public values here:
# never a service-role/secret key, database password, or JWT secret.

# Base URL of the Express API. Leave as /api/v1 in development (Vite proxies it to http://localhost:4000).
# In production use the full API URL, e.g. https://api.your-domain.example/api/v1
VITE_API_URL=/api/v1

# Supabase: Project Settings > API. The anon / publishable key is designed to be public.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
